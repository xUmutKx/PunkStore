<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <queries><package android:name="com.google.android.gms" /></queries>
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Punk Store"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.Punk">
        <activity android:name=".MainActivity" android:label="Punk&#10;Store" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider android:name="androidx.core.content.FileProvider" android:authorities="com.punkstore.app.files" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
        <service android:name=".DownloadService" android:exported="false" android:foregroundServiceType="dataSync" />
        <service android:name=".UpdateJobService" android:exported="false" android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver android:name=".InstallReceiver" android:exported="false" />
        <receiver android:name=".UpdatesWidget" android:exported="false" android:label="Punk Store Updates · Steam">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_updates_steam_info" />
        </receiver>
        <receiver android:name=".UpdatesMaterialWidget" android:exported="false" android:label="Punk Store Updates · Material">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_updates_material_info" />
        </receiver>
        <receiver android:name=".DownloadsWidget" android:exported="false" android:label="Punk Store Downloads · Steam">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_downloads_steam_info" />
        </receiver>
        <receiver android:name=".DownloadsMaterialWidget" android:exported="false" android:label="Punk Store Downloads · Material">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_downloads_material_info" />
        </receiver>
        <receiver android:name=".ReposWidget" android:exported="false" android:label="Punk Store My apps · Steam">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_repos_steam_info" />
        </receiver>
        <receiver android:name=".ReposMaterialWidget" android:exported="false" android:label="Punk Store My apps · Material">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_repos_material_info" />
        </receiver>
        <receiver android:name=".DlActionReceiver" android:exported="false" />
    </application>
</manifest>
