<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wu_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:padding="14dp" android:background="@drawable/widget_updates_bg">
    <TextView android:id="@+id/wu_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Punk Store" android:textColor="#B8C4D4" android:textSize="12sp" android:singleLine="true" />
    <TextView android:id="@+id/wu_count" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="0" android:textColor="#FFFFFF" android:textSize="34sp" android:textStyle="bold" android:singleLine="true" />
    <TextView android:id="@+id/wu_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:textColor="#B8C4D4" android:textSize="12sp" android:singleLine="true" />
</LinearLayout>
