<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wr_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg_steam">
    <TextView android:id="@+id/wr_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Punk Store" android:textColor="#66C0F4" android:textSize="12sp" android:textStyle="bold" android:singleLine="true" android:paddingBottom="4dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/wr_i1" android:layout_width="26dp" android:layout_height="26dp" android:scaleType="centerCrop" android:visibility="gone" />
        <TextView android:id="@+id/wr_n1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:textColor="#FFFFFF" android:textSize="13sp" android:singleLine="true" />
        <TextView android:id="@+id/wr_s1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#8F98A0" android:textSize="11sp" android:singleLine="true" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/wr_i2" android:layout_width="26dp" android:layout_height="26dp" android:scaleType="centerCrop" android:visibility="gone" />
        <TextView android:id="@+id/wr_n2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:textColor="#FFFFFF" android:textSize="13sp" android:singleLine="true" />
        <TextView android:id="@+id/wr_s2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#8F98A0" android:textSize="11sp" android:singleLine="true" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/wr_i3" android:layout_width="26dp" android:layout_height="26dp" android:scaleType="centerCrop" android:visibility="gone" />
        <TextView android:id="@+id/wr_n3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:textColor="#FFFFFF" android:textSize="13sp" android:singleLine="true" />
        <TextView android:id="@+id/wr_s3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#8F98A0" android:textSize="11sp" android:singleLine="true" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/wr_i4" android:layout_width="26dp" android:layout_height="26dp" android:scaleType="centerCrop" android:visibility="gone" />
        <TextView android:id="@+id/wr_n4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:textColor="#FFFFFF" android:textSize="13sp" android:singleLine="true" />
        <TextView android:id="@+id/wr_s4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#8F98A0" android:textSize="11sp" android:singleLine="true" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/wr_i5" android:layout_width="26dp" android:layout_height="26dp" android:scaleType="centerCrop" android:visibility="gone" />
        <TextView android:id="@+id/wr_n5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:textColor="#FFFFFF" android:textSize="13sp" android:singleLine="true" />
        <TextView android:id="@+id/wr_s5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#8F98A0" android:textSize="11sp" android:singleLine="true" />
    </LinearLayout>
</LinearLayout>
