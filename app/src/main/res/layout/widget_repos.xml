    <TextView android:id="@+id/wr_2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:textColor="#FFFFFF" android:textSize="13sp" android:singleLine="true" />
    <TextView android:id="@+id/wr_3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:textColor="#FFFFFF" android:textSize="13sp" android:singleLine="true" />
    <TextView android:id="@+id/wr_4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:textColor="#FFFFFF" android:textSize="13sp" android:singleLine="true" />
    <TextView android:id="@+id/wr_5" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:textColor="#FFFFFF" android:textSize="13sp" android:singleLine="true" />
